# Auth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Administrador principal
AUTH_ADMIN_EMAIL=brechasdigitales@proyecto-puente.org

# Opcional: correos fijos separados por coma.
# Para administración dinámica usar Upstash Redis.
AUTH_ALLOWED_EMAILS=

# Upstash Redis (Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Compatibilidad con integraciones Vercel que usan prefijo KV
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Opcional: código maestro de recuperación.
# Debe contener SHA-256 hexadecimal del código normalizado en mayúsculas.
AUTH_EMERGENCY_CODE_HASH=


# Análisis IA gratuito (Google Gemini Developer API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
